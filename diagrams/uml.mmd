classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +time day_end
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(name: str) None
        +get_all_tasks() list~Task~
        +set_availability(minutes: int, start: time, end: time) None
    }

    class Pet {
        +str name
        +str species
        +int age
        +str notes
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task_id: int) None
        +edit_task(task_id: int, changes: dict) None
        +complete_task(task_id: int) None
        +get_tasks(include_completed: bool) list~Task~
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +str priority
        +time preferred_time
        +str frequency
        +bool completed
        +str pet_name
        +date due_date
        +int id
        +mark_complete() Task | None
        +priority_score() int
        +is_due_today(day: date) bool
        +to_dict() dict
    }

    class Scheduler {
        +Owner owner
        +collect_tasks(day: date) list~Task~
        +sort_tasks(tasks: list~Task~) list~Task~
        +filter_tasks(tasks: list~Task~, minutes: int) tuple
        +assign_times(tasks: list~Task~) list~ScheduledTask~
        +detect_conflicts(items: list~ScheduledTask~) list~str~
        +build_plan(day: date) DailyPlan
    }

    class ScheduledTask {
        +Task task
        +time start_time
        +time end_time
        +str reason
    }

    class DailyPlan {
        +date date
        +list~ScheduledTask~ scheduled
        +list~tuple~ skipped
        +int total_minutes
        +list~str~ warnings
        +summary() str
        +explain() str
        +to_rows() list~dict~
    }

    Owner "1" *-- "*" Pet : owns
    Pet "1" *-- "*" Task : has
    Scheduler --> Owner : reads constraints from
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" *-- "*" ScheduledTask : contains
    ScheduledTask --> "1" Task : wraps
